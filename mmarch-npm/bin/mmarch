#!/usr/bin/env node

"use strict";

const { spawnSync } = require("child_process");
const { optionalDependencies, version } = require("../package.json");

const platform = `${process.platform}-${process.arch}`;
const packageName = `mmarch-${platform}`;

if (!Object.prototype.hasOwnProperty.call(optionalDependencies, packageName)) {
  console.error(
    `[mmarch] Unsupported platform: ${platform}.\n` +
    `Supported: ${Object.keys(optionalDependencies).map(name => name.slice(7)).join(", ")}`
  );
  process.exit(1);
}

const binName = process.platform === "win32" ? "mmarch.exe" : "mmarch";
let binPath;
try {
  binPath = require.resolve(`${packageName}/${binName}`);
} catch {
  console.error(
    `[mmarch] Could not find the binary in ${packageName}@${version}.\n` +
    `Reinstall mmarch with optional dependencies enabled (do not use --omit=optional or --no-optional).\n` +
    `For a global npm install: npm install -g mmarch@${version} --include=optional\n` +
    `With npm 6, use --optional instead of --include=optional.`
  );
  process.exit(1);
}

const result = spawnSync(binPath, process.argv.slice(2), {
  stdio: "inherit",
  windowsHide: true,
});

if (result.error) {
  console.error(`[mmarch] Could not execute ${binPath}: ${result.error.message}`);
  process.exit(1);
}
if (result.signal) {
  process.kill(process.pid, result.signal);
} else {
  process.exit(result.status === null ? 1 : result.status);
}
